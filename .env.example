# 32文字以上のランダムな文字列にすること (iron-session の要件)
SESSION_PASSWORD=change_me_to_a_random_string_of_32_or_more_chars

# GitHub OAuth App の値 (callback URL: http://localhost:3000/auth/github)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# Docker Compose のサービス名 db を指す
DATABASE_URL=postgresql://postgres:postgres@db:5432/card_debit_manager?schema=public
